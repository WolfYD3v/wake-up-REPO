[node name="Label3D5" type="Label3D" parent="." index="7"]
transform = Transform3D(-4.371139e-08, -1, -4.371139e-08, 0, -4.371139e-08, 1, -1, 4.371139e-08, 1.9106855e-15, -5.868065, 2.7521155, -4.2658744)
modulate = Color(0.34407577, 0.34407574, 0.34407574, 1)
text = "During war humans act
like animals, like tyrans.
And the little ones have
to follow the absurd rules
of the big ones."
font_size = 40
outline_size = 0

[node name="Label3D4" type="Label3D" parent="." index="8"]
transform = Transform3D(-4.371139e-08, -1, -4.371139e-08, 0, -4.371139e-08, 1, -1, 4.371139e-08, 1.9106855e-15, -13.668065, 2.7521155, -4.8658743)
modulate = Color(0.34407577, 0.34407574, 0.34407574, 1)
