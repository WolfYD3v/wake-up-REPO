[node name="Label3D3" type="Label3D" parent="." index="6"]
transform = Transform3D(-4.371139e-08, -1, -4.371139e-08, 0, -4.371139e-08, 1, -1, 4.371139e-08, 1.9106855e-15, 0.3, 2.7521155, -5.165874)
modulate = Color(0.34407577, 0.34407574, 0.34407574, 1)
text = "\"It's just what I
