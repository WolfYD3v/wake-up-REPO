[node name="Label3D2" type="Label3D" parent="." index="5"]
transform = Transform3D(-4.371139e-08, 1, 4.371139e-08, 0, -4.371139e-08, 1, 1, 4.371139e-08, 1.9106855e-15, 5, 2.7521155, -2.065874)
modulate = Color(0.34407577, 0.34407574, 0.34407574, 1)
text = "Do you feel ashamed?
